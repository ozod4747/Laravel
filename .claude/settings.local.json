{
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(mysql:*)",
      "Bash(sudo mysql:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(ss -tlnp | grep 3306 2>&1)",
      "Bash(docker port:*)",
      "Bash(ss -tlnp | grep 3306 -A2 -B2 2>&1)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
